rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null;
    }

    match /pages/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /treatments/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /blogs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /videos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /media/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
